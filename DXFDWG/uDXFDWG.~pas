  cor: tcolor;
begin
 TextFile := TStringList.Create;
  try
    if Image1.Picture.Graphic is TsgCADImage then
    begin
      FCADParams.Matrix := cnstIdentityMat;

      S := '';

      for I := 0 to (Image1.Picture.Graphic as TsgCADImage).Converter.Counts[csLayers] - 1 do
      begin
        cor := (Image1.Picture.Graphic as TsgCADImage).Converter.Layers[I].Color;

        S := S + '$LAYER$' + #13#10;
