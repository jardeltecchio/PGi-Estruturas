procedure tFDXFDWG.ImportText(Sender: TObject);
var
  P: TFPoint;
  S,texto: string;
begin
  DoScale2D(FCADParams);
  P := FPointXMat(TsgDXFText(Sender).StartPoint, FCADParams.Matrix);
  //S := S + ' Start point: ';
  S := S + 'X=' + FloatToStr(P.X);
  S := S + ' Y=' + FloatToStr(P.Y);
  S := S + ' Z=' + FloatToStr(P.Z);
  S := S + ' A=' + FloatToStr(TsgDXFText(Sender).Rotation + FCADParams.Angle);
  S := S + #13#10 +ImportTextFont(Sender);

  texto := LimpaChrEspecial(TsgDXFText(Sender).Text);

  S := S + #13#10'T=' + texto;
  S := S + #13#10;
  S := S + TsgDXFText(Sender).Layer.Name;
  TextFile.Add(S);
end;

function tFDXFDWG.LimpaChrEspecial(Str: string): string;
const
  cS1 = '‡‚‰„·ÍÈÎËÌÔÏÓÙˆıÛÚ˚˙¸˘ÁÒ˝ˇ¿¬ƒ√¡ …À»ÕœÃŒ‘÷’”“€⁄‹Ÿ«—›ü';
  cS2 = 'aaaaaeeeeiiiiooooouuuucnyyAAAAAEEEEIIIIOOOOOUUUUCNYY';
var
  I: integer;
begin
  for I := 1 to Length(Str) do
    if Pos(Str[I], cS1) <> 0 then
      Str[I] := cS2[Pos(Str[I], cS1)];
  Result := Str;
end;

procedure tFDXFDWG.ImportSpline(Sender: TObject);
var
  vSpline: TsgDXFSpline absolute Sender;
  P: TFPoint;
  S: string;
  I: Integer;
begin
  if vSpline.FitCount > 0 then
  begin
    S := S + ' Fit points of Spline: ';
    for I := 0 to vSpline.FitCount - 1 do
    begin
      S := S + #13#10 + ' P' + IntToStr(I + 1) + ': ';
      P := FPointXMat(vSpline.Fit[I], FCADParams.Matrix);
      S := S + PointToString(P);
    end;
    S := S + #13#10;
  end;
  if vSpline.ControlCount > 0 then
  begin
    S := S + ' Control points of Spline: ';
    for I := 0 to vSpline.ControlCount - 1 do
    begin
      S := S + #13#10 + ' P' + IntToStr(I + 1) + ': ';
      P := FPointXMat(vSpline.Controls[I], FCADParams.Matrix);
      S := S + PointToString(P);
    end;
    S := S + #13#10;
  end;
  TextFile.Add(S);
end;

