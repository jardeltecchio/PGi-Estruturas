  end;

end;

function PointToString(const P: TFPoint): string;
begin
  Result := ' X='+ FloatToStr(P.X)+ ' Y='+ FloatToStr(P.Y)+ ' Z='+ FloatToStr(P.Z);
end;

{ All elements inside inserts can be reached in the next procedure.
  Proc called for Inserts too }
function tFDXFDWG.ReadCADEntities(Entity: TsgDXFEntity): Integer;
const
  PS: array[psSolid..psDashDot] of string =
    ('psSolid','psDash','psDot','psDashDot');
var
  S: string;
  L: TsgDXFLayer;
  C: TColor;
begin
  Result := 0;
  S := #13#10'ClassName=' + Entity.ClassName + '; Entity name=' + Entity.EntName;
  DoScale2D(FCADParams); // calculates 2d scale and rotation

  // layer
  L := EntLayer(Entity, FCADParams.Insert);
  if L <> nil then
    S := S + ' layer = ' + L.Name;

  // color
  S := S + ' style = ' + PS[EntStyle(Entity)];
  C := EntColor(Entity, FCADParams.Insert);
  if C = clNone then
    S := S + ' color=black/white'
  else
    S := S + ' color = ' +  IntToHex(C, -6) + ' (' + ColorToString(C) + ')';


  // particular properties
  TextFile.Add(S);
  case Entity.EntType of
    ceLine:      ImportLine(Entity);    //Line - see cadmage.pas TsgCADImage.DrawArc
    cePoint:     ImportPoint(Entity);   //Point - see cadmage.pas TsgCADImage.DrawPoint
    ceCircle:    ImportCircle(Entity);  //Circle - see cadmage.pas TsgCADImage.DrawArc
    ceArc:       ImportArc(Entity);     //Arc - see cadmage.pas TsgCADImage.DrawArc
    ceEllipse:   ImportEllipse(Entity); //Ellipse - see cadmage.pas TsgCADImage.DrawArc
    cePolyline, cePath:    ImportPolyLine(Entity);//PolyLine - see cadmage.pas TsgCADImage.DrawPolyLine
    ceLWPolyline:    ImportLWPolyLine(Entity);
    ceFlatPoly:  ImportFlatPolyLine(Entity);//FlatPoly - see cadmage.pas TsgCADImage.DrawPolyLine
    ceSpline,                           //Spline - see cadmage.pas TsgCADImage.DrawSpline
      ceLeader:  ImportSpline(Entity);  //Leader - see cadmage.pas TsgCADImage.DrawLeader
    ceText:      ImportText(Entity);    //Text - see cadmage.pas TsgCADImage.DrawText
    ceAttdef,
      ceAttrib:  ImportAttdef(Entity);  //Attdef - see cadmage.pas TsgCADImage.DrawText
    ceSolid,                            //Solid  - see cadmage.pas TsgCADImage.DrawSolid
      ce3dFace:  ImportSolid(Entity);   //Face - see cadmage.pas TsgCADImage.DrawFace
    ceViewport:
      begin
        Result := 1;
        ImportViewPortBegin(Entity);    //ViewPort - see cadmage.pas TsgCADImage.DrawViewPort
      end;
  end;
end;

function tFDXFDWG.FinishReadCADEntities(Entity: TsgDXFEntity): Integer;
begin
  case Entity.EntType of
    ceViewport:
      begin
        Result := 1;
        ImportViewPortEnd(Entity);
      end;
  else
    Result := 0;
  end;
end;

