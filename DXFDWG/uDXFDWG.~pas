procedure TFDXFDWG.FormCreate(Sender: TObject);
const
  Exts: array[0..17] of string = ( '.dxf', '.dwg', '.plt', '.hgl', '.rtl',
    '.hg', '.plo', '.hp', '.hp1', '.hp2', '.hpg', '.hpgl', '.hpgl2', '.gl2',
    '.prn', '.spl', '.svg', '.cgm');
var
  vFileExt, caminho: string;

  procedure ViewLayouts;
  var
    I: Integer;
  begin
    if Img <> nil then
    begin
      cbLayouts.Visible := false;
      lblLayouts.Visible := false;
      cbLayouts.Items.Clear;
      for I := 0 to Img.LayoutsCount - 1 do
        cbLayouts.Items.AddObject(Img.Layouts[I].Name, Img.Layouts[I]);
      cbLayouts.ItemIndex := Img.Converter.DefaultLayoutIndex;
      Img.CurrentLayout := Img.Layouts[cbLayouts.ItemIndex];
    end;
  end;
begin
  DeleteFile(Caminho + 'DWGDXF_Importando_FECHOU.txt');
  DeleteFile(Caminho + 'DWGDXF_Importando.txt');
  lbpreparando.Visible := false;

  OpenPictureDialog1.Filter := GraphicFilter(TGraphic);
  {$IFDEF DEMO}
  fInfo.CreateInfoFrame(Handle, Point(10, 50));
  {$ENDIF}
  OpenPictureDialog1.FileName := '';
  if OpenPictureDialog1.Execute then
  begin
    Self.Show;
    lbPreparando.Visible := true;
    self.Refresh;
    vFileExt := ExtractFileExt(LowerCase(OpenPictureDialog1.FileName));
    Img.Free;
    Img := nil;
    case StrIndex(vFileExt, Exts) of
      0:	Img := TsgCADdxfImage.Create;
      {$IFNDEF sgDFONLY}
      1:	Img := TsgDWGImage.Create;
      2..15:	Img := TsgHPGLImage.Create;
      16:     Img := TsgSVGImage.Create;
      17:     Img := TsgCGMImage.Create;
      {$ENDIF}
    end;
    if Img <> nil then
    begin
      Img.LoadFromFile(OpenPictureDialog1.FileName);
      img.BackgroundColor := clblack;
      ViewLayouts;
      Image1.Picture.Assign(Img);
    end;
    lbpreparando.Visible := false;
    pnForm.Caption := 'Arquivo: ' + OpenPictureDialog1.FileName;
  end
  else
  begin
     TextFile := TStringList.Create;
     Caminho  := ExtractFilePath(Application.ExeName);
     TextFile.SaveToFile(Caminho + 'DWGDXF_Importando_FECHOU.txt');
     Application.Terminate;
  end;
end;

procedure TFDXFDWG.JvXPButton1Click(Sender: TObject);
